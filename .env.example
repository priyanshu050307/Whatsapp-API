# Server Configuration
PORT=3005
NODE_ENV=production

# Legacy API Gateway Authentication credentials (Change before first run)
API_USERNAME=14125037
API_PASSWORD=change_me_strong_api_password
API_CHANNEL_ID=29979

# Security & Rate-Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=25
CORS_ORIGIN=*

# WhatsApp Configurations
PUPPETEER_HEADLESS=true
SESSION_PATH=./session

# SQLite Configurations (true/false)
USE_SQLITE=true

# Authentication & Multi-Tenant Configurations (CRITICAL: Generate strong secrets in production)
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
JWT_SECRET=replace_with_64_byte_cryptographic_random_hex_secret
MASTER_ADMIN_PASSWORD=replace_with_strong_master_admin_passphrase
DEFAULT_TRIAL_DAYS=15

# Firebase Web App Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
